# Gizlet mirror: serves @ORIGIN@ under @MIRROR@ with an optional website.
#
#   @MIRROR@          -> @ORIGIN@          (optional site, share pages, sign-in)
#   www.@MIRROR@      -> 301 to @MIRROR@   (when the site is enabled)
#
# Rendered by render.sh. Goes in the http context (conf.d).

# The Worker checks Origin (Better Auth, CORS) against @ORIGIN@'s origins, so the mirror's
# origins are sent upstream as the ones they stand for.
map $http_origin $gizlet_mirror_origin {
    default                 $http_origin;
    "https://@MIRROR@"      "https://@ORIGIN@";
}

map $http_referer $gizlet_mirror_referer {
    default                                           $http_referer;
    "~^https://@MIRROR_RE@(?<p>[/?#].*)?$"  "https://@ORIGIN@${p}";
}

# Account routes answer CORS with Access-Control-Allow-Origin: https://@ORIGIN@.
map $upstream_http_access_control_allow_origin $gizlet_mirror_acao {
    default                 $upstream_http_access_control_allow_origin;
    "https://@ORIGIN@"      "https://@SITE_DOMAIN@";
}

upstream gizlet_mirror_site {
    zone gizlet_mirror_site 256k;
    resolver @RESOLVER@ valid=300s ipv6=off;
    server @ORIGIN@:@ORIGIN_HTTPS_PORT@ resolve;
    keepalive 16;
}

ssl_session_cache shared:gizlet_mirror:10m;

@CACHE_BEGIN@
proxy_cache_path @CACHE_PATH@ levels=1:2 keys_zone=gizlet_downloads:32m
    max_size=@CACHE_MAX_SIZE@ min_free=@CACHE_MIN_FREE@ inactive=@CACHE_INACTIVE@ use_temp_path=off;

map $request_uri $gizlet_versioned_download {
    default 0;
    "~^/assets/releases/v[0-9]+\.[0-9]+\.[0-9]+/[^?]+$" 1;
}

map "$gizlet_versioned_download:$http_authorization:$http_cookie" $gizlet_skip_cache {
    "1::" 0;
    default 1;
}

map "$upstream_status:$upstream_http_cache_control" $gizlet_skip_store {
    default 1;
    ~*(?:private|no-cache|no-store) 1;
    ~*^200:(?=.*\bpublic\b)(?=.*\bimmutable\b) 0;
}
@CACHE_END@

# Plain HTTP: ACME challenges for the certificate, everything else to HTTPS.
server {
    listen @HTTP_PORT@;
    listen [::]:@HTTP_PORT@;
    server_name @MIRROR@ www.@MIRROR@;

    location /.well-known/acme-challenge/ {
        root @ACME_ROOT@;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen @HTTPS_PORT@ ssl;
    listen [::]:@HTTPS_PORT@ ssl;
    http2 on;
    server_name @SITE_SERVER_NAMES@;

    ssl_certificate     @SSL_CERT@;
    ssl_certificate_key @SSL_KEY@;
    ssl_protocols       TLSv1.2 TLSv1.3;

    return @SITE_RESPONSE@;
}

# The API and optional site: rewrite absolute URLs in pages, scripts and JSON.
server {
    listen @HTTPS_PORT@ ssl;
    listen [::]:@HTTPS_PORT@ ssl;
    http2 on;
    server_name @MIRROR@;

    ssl_certificate     @SSL_CERT@;
    ssl_certificate_key @SSL_KEY@;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 1m;

    # Every proxy_set_header is here: one in a location would drop all of these.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host @ORIGIN@;
    proxy_set_header Origin $gizlet_mirror_origin;
    proxy_set_header Referer $gizlet_mirror_referer;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # Uncompressed answers, so sub_filter can rewrite them; gzip below compresses them again.
    proxy_set_header Accept-Encoding "";

    proxy_ssl_server_name on;
    proxy_ssl_name @ORIGIN@;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate @CA_BUNDLE@;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_ssl_session_reuse on;

    proxy_redirect "~^https://@ORIGIN_RE@(?<sp>[/?#].*)?$" "https://@SITE_DOMAIN@${sp}";
    # Better Auth's cookies are for @ORIGIN@ and its subdomains (a leading dot is ignored).
    proxy_cookie_domain @ORIGIN@ @MIRROR@;

    proxy_hide_header Access-Control-Allow-Origin;
    add_header Access-Control-Allow-Origin $gizlet_mirror_acao always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_types application/json text/javascript application/javascript text/css text/plain;

    location / {
        if ($gizlet_serve_site = 0) { return 404; }
        sub_filter_types application/json text/javascript application/javascript text/css text/plain;
        sub_filter_once off;
        sub_filter_last_modified on;
        sub_filter "audience=https://@ORIGIN@/api" "audience=https://@ORIGIN@/api";
        sub_filter "https://@ORIGIN@/api/" "https://@MIRROR@/api/";
        sub_filter "https://@ORIGIN@/assets/" "https://@MIRROR@/assets/";
        sub_filter "https://@ORIGIN@" "https://@SITE_DOMAIN@";
        proxy_pass https://gizlet_mirror_site;
    }

    location ^~ /assets/ {
        limit_except GET HEAD { deny all; }
        gzip off;
        proxy_set_header Host @ORIGIN@;
        proxy_set_header Connection "";
        proxy_set_header Accept-Encoding "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_ssl_name @ORIGIN@;
        proxy_redirect "~^https://@ORIGIN_RE@(/assets/.*)$" "https://@MIRROR@$1";
        proxy_redirect "~^https://@ORIGIN_RE@(/.*)$" "https://@SITE_DOMAIN@$1";
        proxy_buffering @DOWNLOAD_BUFFERING@;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
@CACHE_BEGIN@
        proxy_set_header X-Gizlet-Skip-Cache $gizlet_skip_cache;
        proxy_cache gizlet_downloads;
        proxy_cache_key "@ORIGIN@$request_uri";
        proxy_cache_bypass $gizlet_skip_cache;
        proxy_no_cache $gizlet_skip_cache $gizlet_skip_store;
        proxy_cache_valid 200 1d;
        proxy_cache_lock on;
        proxy_cache_lock_age 300s;
        proxy_cache_lock_timeout 300s;
        proxy_cache_max_range_offset 1;
        add_header X-Mirror-Cache $upstream_cache_status always;
@CACHE_END@
        proxy_pass @ASSET_UPSTREAM@;
    }
}

map "@SERVE_SITE@:$uri" $gizlet_serve_site {
    default 1;
    ~^false:/api/v1(?:/|$) 1;
    ~^false: 0;
}
